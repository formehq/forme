{
  "name": "forme",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first Living Project Twin with bounded agent execution.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "validate": "node schema/validate-samples.ts",
    "test": "node --test schema/*.test.ts runner/*.test.ts runtime/*.test.ts twin/*.test.ts console/*.test.ts launchd/*.test.ts",
    "typecheck": "tsc --noEmit",
    "run:once": "node runner/index.ts",
    "run:console": "node console/server.ts",
    "run:taste": "node runner/taste.ts",
    "run:statediff": "node runner/state-diff.ts",
    "runtime:preflight": "node runtime/preflight.ts",
    "twin:init": "node twin/cli.ts init",
    "twin:refresh": "node twin/cli.ts refresh",
    "twin:status": "node twin/cli.ts status"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
