{
  "name": "forme",
  "version": "0.1.0",
  "private": true,
  "description": "Owner-controlled Living Project Twin",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "forme": "./bin/forme.js"
  },
  "files": [
    "bin",
    "packages/r4-codex-adapter",
    "packages/r4-local",
    "packages/r4-persistence",
    "packages/r4-protocol",
    "schemas",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "forme": "node src/cli.ts",
    "room:dev": "next dev apps/room",
    "room:compile": "next build apps/room",
    "room:build": "npm run room:compile && node scripts/r4-room-standalone-prepare.mjs && npm run r4:room-build:audit",
    "room:start": "node apps/room/.next/standalone/apps/room/server.js",
    "r4:walkthrough": "node packages/r4-local/src/walkthrough.ts",
    "r4:probe-basis": "node packages/r4-local/src/real-basis-probe-cli.ts",
    "r4:postgres:rehearse": "node scripts/r4-disposable-postgres-rehearsal.mjs",
    "r4:postgres:diagnose": "node scripts/r4-disposable-postgres-rehearsal.mjs diagnose",
    "r4:postgres:diagnose:pull": "node scripts/r4-disposable-postgres-rehearsal.mjs diagnose --allow-image-pull",
    "r4:postgres:diagnose-rollback": "node scripts/r4-disposable-postgres-rehearsal.mjs diagnose-rollback",
    "r4:postgres:diagnose-rollback:pull": "node scripts/r4-disposable-postgres-rehearsal.mjs diagnose-rollback --allow-image-pull",
    "r4:room:runtime-rehearse": "node scripts/r4-local-public-core-runtime-rehearsal.mjs execute",
    "r4:room:runtime-rehearse:pull": "node scripts/r4-local-public-core-runtime-rehearsal.mjs execute --allow-image-pull",
    "r4:owner-staging": "node scripts/r4-owner-encounter-staging.mjs",
    "r4:audit": "node scripts/r4-gate-a-static-audit.mjs",
    "r4:room-build:audit": "node scripts/r4-room-build-audit.mjs",
    "r4:docs:audit": "node scripts/r4-doc-audit.mjs",
    "r4:inventory": "node scripts/r4-source-inventory.mjs",
    "r4:gate-b:encrypted-field": "node scripts/r4-gate-b-encrypted-field.mjs check",
    "r4:gate-b:fake-budget": "node scripts/r4-gate-b-fake-budget.mjs check",
    "r4:gate-b:codex-probe": "node scripts/r4-gate-b-codex-probe.mjs check",
    "r4:gate-b:macos": "sh scripts/r4-gate-b-macos-probe.sh check",
    "r4:gate-b": "node scripts/r4-gate-b-runner.mjs execute",
    "r4:gate-b:dry-run": "node scripts/r4-gate-b-runner.mjs dry-run",
    "r4:gate-b:core-dry-run": "node scripts/r4-gate-b-runner.mjs dry-run-core",
    "r4:gate-b:preflight": "node scripts/r4-gate-b-preflight.mjs check",
    "r4:gate-b:contracts": "node scripts/r4-gate-b-api-contract.mjs check",
    "r4:gate-b:core-contracts": "node scripts/r4-gate-b-core-api-contract.mjs check",
    "r4:gate-b:core-postgres": "node scripts/r4-gate-b-core-postgres.mjs check",
    "r4:gate-b:core-codex": "node scripts/r4-gate-b-codex-probe.mjs check-core",
    "r4:gate-b:core-macos": "node scripts/r4-gate-b-macos-core.mjs check",
    "r4:gate-b:postgres": "node scripts/r4-gate-b-postgres.mjs check",
    "r4:gate-b:macos-probe": "sh scripts/r4-gate-b-macos-probe.sh check",
    "r4:gate-b:cleanup": "node scripts/r4-gate-b-cleanup.mjs cleanup",
    "test:spine": "node --test test/*.test.ts",
    "test:r4": "node --test 'test/r4/**/*.test.ts'",
    "test:r4:gate-b-core": "node --import ./scripts/deny-external-network.mjs --test 'test/r4-gate-b-core/**/*.test.ts'",
    "test:r4:offline": "node --import ./scripts/deny-external-network.mjs --test 'test/r4/**/*.test.ts'",
    "test": "npm run test:spine && npm run test:r4 && npm run test:r4:gate-b-core",
    "typecheck:spine": "tsc --noEmit",
    "typecheck:room": "tsc --project apps/room/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:spine && npm run typecheck:room",
    "check:room-boundary": "npm --workspace apps/room run check:no-ai",
    "check": "npm run typecheck && npm run check:room-boundary && npm test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2"
  }
}
