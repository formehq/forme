{
  "name": "@forme/room",
  "version": "0.1.0",
  "private": true,
  "description": "Forme R4 hosted Room control and relay plane",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
