{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forme.dev/schemas/agent-message-v0.json",
  "title": "Forme Agent Message v0",
  "type": "object",
  "required": [
    "schemaVersion",
    "messageId",
    "threadId",
    "sentAt",
    "from",
    "to",
    "projectionRef",
    "intent",
    "body",
    "attribution",
    "trust",
    "limits"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0"
    },
    "messageId": {
      "type": "string",
      "pattern": "^msg_[A-Za-z0-9_-]+$"
    },
    "threadId": {
      "type": "string",
      "pattern": "^thr_[A-Za-z0-9_-]+$"
    },
    "replyTo": {
      "type": "string",
      "pattern": "^msg_[A-Za-z0-9_-]+$"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time"
    },
    "from": {
      "$ref": "#/$defs/address"
    },
    "to": {
      "$ref": "#/$defs/address"
    },
    "projectionRef": {
      "type": "object",
      "required": ["projectionId", "version"],
      "properties": {
        "projectionId": {
          "type": "string",
          "pattern": "^prj_[A-Za-z0-9_-]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "intent": {
      "enum": ["introduction", "question", "collaboration-request", "proposal"]
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "attribution": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["human", "agent-drafted", "owner-approved", "auto-delegated"]
        },
        "approvedBy": {
          "type": "string",
          "pattern": "^idn_[A-Za-z0-9_-]+$"
        },
        "authorizationGrantId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "trust": {
      "const": "untrusted-external"
    },
    "limits": {
      "type": "object",
      "required": ["expiresAt", "maxReplyTurns"],
      "properties": {
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "maxReplyTurns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "address": {
      "type": "object",
      "required": ["identityId", "agentId"],
      "properties": {
        "identityId": {
          "type": "string",
          "pattern": "^idn_[A-Za-z0-9_-]+$"
        },
        "agentId": {
          "type": "string",
          "pattern": "^agt_[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "attribution": {
            "properties": {
              "mode": {
                "const": "owner-approved"
              }
            },
            "required": ["mode"]
          }
        }
      },
      "then": {
        "properties": {
          "attribution": {
            "required": ["approvedBy"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "attribution": {
            "properties": {
              "mode": {
                "const": "auto-delegated"
              }
            },
            "required": ["mode"]
          }
        }
      },
      "then": {
        "properties": {
          "attribution": {
            "required": ["authorizationGrantId"]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
