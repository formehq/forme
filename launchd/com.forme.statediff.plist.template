<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.forme.statediff</string>

  <!-- 周日 State Diff(issue #11):直接 exec node(同 runner 的取舍),
       周更守卫在生成器本体(min-days 6,按最新产物文件名日期防同周重复)。 -->
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE}}</string>
    <string>{{REPO}}/runner/state-diff.ts</string>
    <string>--vault</string><string>{{VAULT}}</string>
    <string>--min-days</string><string>6</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>{{PATH}}</string>
  </dict>

  <!-- 每周日固定时刻;睡眠错过的日程 macOS 唤醒时补发 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>{{SD_HOUR}}</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- 不设 RunAtLoad:装机/登录不触发——第一张 State Diff 必须产在周日,
       守卫(min-days,按最新产物文件名日期)对"从未生成过"拦不住 RunAtLoad。
       周日睡眠错过由 macOS 唤醒补发覆盖;整机关机的极端情形顺延下周日。 -->

  <key>ThrottleInterval</key><integer>3600</integer>
  <key>StandardOutPath</key><string>{{LOG}}/statediff.log</string>
  <key>StandardErrorPath</key><string>{{LOG}}/statediff.log</string>
</dict>
</plist>
