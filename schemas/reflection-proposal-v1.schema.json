{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forme.dev/schemas/reflection-proposal-v1.json",
  "title": "Forme R2 Reflection Proposal v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "proposalId",
    "baseTwinRevision",
    "claim",
    "relationType",
    "evidenceIds",
    "uncertainty",
    "alternativeExplanation",
    "implication",
    "ownerQuestion"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "proposalId": { "type": "string", "pattern": "^prp_[a-f0-9]{32}$" },
    "baseTwinRevision": { "type": "integer", "minimum": 1 },
    "claim": { "type": "string", "minLength": 80, "maxLength": 4000 },
    "relationType": { "type": "string", "enum": ["pattern", "tension", "trajectory", "unfinished"] },
    "evidenceIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": { "type": "string", "pattern": "^ev_[a-f0-9]{32}$" }
    },
    "uncertainty": {
      "type": "object",
      "required": ["level", "rationale"],
      "properties": {
        "level": { "type": "string", "enum": ["low", "medium", "high"] },
        "rationale": { "type": "string", "minLength": 30, "maxLength": 2000 }
      },
      "additionalProperties": false
    },
    "alternativeExplanation": { "type": "string", "minLength": 30, "maxLength": 2000 },
    "implication": { "type": "string", "minLength": 30, "maxLength": 2000 },
    "ownerQuestion": { "type": "string", "minLength": 10, "maxLength": 1000 }
  },
  "additionalProperties": false
}
