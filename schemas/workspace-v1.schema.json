{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forme.dev/schemas/workspace-v1.json",
  "title": "Forme R1 Workspace Contract v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "workspaceId",
    "name",
    "createdAt",
    "source",
    "ownerFrame"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "workspaceId": {
      "type": "string",
      "pattern": "^wsp_[a-f0-9]{32}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "root",
        "includePaths",
        "excludeNames",
        "maxFileBytes",
        "followSymlinks"
      ],
      "properties": {
        "root": { "$ref": "#/$defs/relativePath" },
        "includePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "excludeNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "not": {
              "anyOf": [
                { "pattern": "[/\\\\]" },
                { "const": "." },
                { "const": ".." }
              ]
            }
          }
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "followSymlinks": { "const": false }
      },
      "additionalProperties": false
    },
    "ownerFrame": { "$ref": "#/$defs/ownerFrame" }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "not": {
        "anyOf": [
          { "pattern": "^(?:/|[A-Za-z]:)" },
          { "pattern": "(?:^|[/\\\\])[.][.](?:[/\\\\]|$)" }
        ]
      }
    },
    "ownerFrame": {
      "type": "object",
      "required": ["activeIntent", "nextMove", "unresolved"],
      "properties": {
        "activeIntent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "nextMove": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "unresolved": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
