{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forme.dev/schemas/action-context-packet-v1.json",
  "title": "Forme R3 Action Context Packet v1",
  "type": "object",
  "required": ["schemaVersion", "packetId", "createdAt", "baseTwinRevision", "ownerFrame", "actionGoal", "correctedReflection", "capability", "constraints"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "packetId": { "type": "string", "pattern": "^acx_[a-f0-9]{32}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "baseTwinRevision": { "type": "integer", "minimum": 1 },
    "ownerFrame": {
      "type": "object",
      "required": ["activeIntent", "nextMove", "unresolved"],
      "properties": {
        "activeIntent": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "nextMove": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "unresolved": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
      },
      "additionalProperties": false
    },
    "actionGoal": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "correctedReflection": {
      "type": "object",
      "required": ["reflectionId", "claim", "relationType", "implication", "evidence", "correctionId", "correctedAt"],
      "properties": {
        "reflectionId": { "type": "string", "pattern": "^ref_[a-f0-9]{32}$" },
        "claim": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "relationType": { "enum": ["pattern", "tension", "trajectory", "unfinished"] },
        "implication": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["schemaVersion", "evidenceId", "timepointId", "commit", "committedAt", "relativePath", "blobHash", "lineStart", "lineEnd", "excerptHash"],
            "properties": {
              "schemaVersion": { "const": "1" },
              "evidenceId": { "type": "string", "pattern": "^ev_[a-f0-9]{32}$" },
              "timepointId": { "enum": ["earlier", "later"] },
              "commit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
              "committedAt": { "type": "string", "format": "date-time" },
              "relativePath": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "blobHash": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
              "lineStart": { "type": "integer", "minimum": 1 },
              "lineEnd": { "type": "integer", "minimum": 1 },
              "excerptHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        },
        "correctionId": { "type": "string", "pattern": "^cor_[a-f0-9]{32}$" },
        "correctedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["actionKind", "targetPath", "markerId"],
      "properties": {
        "actionKind": { "const": "render_next_move_brief.v1" },
        "targetPath": { "const": "README.md" },
        "markerId": { "const": "forme:r3-action" }
      },
      "additionalProperties": false
    },
    "constraints": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
  },
  "additionalProperties": false
}
