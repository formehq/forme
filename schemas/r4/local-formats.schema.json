    "OpaqueId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]{16,128}$",
      "maxLength": 160
    },
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "Capability32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "IdempotencyKey": {
      "type": "string",
      "pattern": "^(?:[A-Fa-f0-9]{32,}|[A-Za-z0-9_-]{22,})$"
    },
