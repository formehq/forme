(version 1)
(deny default)
(import "dyld-support.sb")
(deny network*)
(deny process-fork)
(deny signal (target others))
(allow signal (target self))
(allow process-info*)
(allow sysctl-read)
(allow process-exec (literal (param "CODEX_NATIVE")))
(allow file-read* (literal (param "CODEX_NATIVE")))
(allow file-read* (literal (param "MODEL_CATALOG")))
(allow file-read* (subpath "/System/Library"))
(allow file-read* (literal "/System/Volumes/Data"))
(allow file-read* (subpath "/usr/lib"))
(allow file-read* (subpath "/private/etc"))
(allow file-read* (subpath "/private/var/db/dyld"))
(allow file-read* (subpath "/private/var/db/timezone"))
(allow file-read* (subpath "/usr/share/icu"))
(allow file-read* (literal "/Library/Preferences/.GlobalPreferences.plist"))
(allow file-read* (literal "/dev/null"))
(allow file-read* (literal "/dev/random"))
(allow file-read* (literal "/dev/urandom"))
(allow file-read-metadata
  (literal "/")
  (literal "/private")
  (literal "/private/tmp")
  (literal "/tmp")
  (literal "/System/Volumes/Data")
  (literal "/System/Cryptexes/App")
  (literal "/System/Cryptexes/OS")
  (literal "/bin/zsh")
  (literal "/etc")
  (literal "/var")
  (literal (param "TEMP_ROOT"))
  (literal (param "SESSION_ROOT")))
(allow file-read*
  (literal (param "TEMP_ROOT"))
  (literal (param "SESSION_ROOT")))
(allow file-read* file-write* (subpath (param "ISOLATED_HOME")))
(allow file-read* file-write* (subpath (param "ISOLATED_CODEX_HOME")))
(allow file-read* file-write* (subpath (param "ISOLATED_TMPDIR")))
(allow network-outbound (remote ip (param "CAPTURE_ENDPOINT")))
