    "constructionOwnerReviewSha256": { "const": "sha256:27c64b28a19969f2d808870d64ad60fbd8b9bdf6b5343fa5d56aa719dd241ff9" },
    "approvedProposalHead": { "const": "a45ea061e8e92f247597787e36ecfe52740b216a" },
    "approvedProposalTree": { "const": "89b28903fc34e985a17e8f3fdc4bfd7d0972880e" },
    "implementationHead": { "$ref": "#/$defs/gitObject" }, "implementationTree": { "$ref": "#/$defs/gitObject" },
    "hostBindingAdapterConstructionGrant": { "const": "APPROVED" },
    "packageLockSha256": { "$ref": "#/$defs/sha" }, "immutableCoreAggregateSha256": { "$ref": "#/$defs/sha" }, "immutableFullAggregateSha256": { "$ref": "#/$defs/sha" },
    "physicalRunnerSha256": { "$ref": "#/$defs/sha" }, "hostBindingModuleSha256": { "$ref": "#/$defs/sha" }, "physicalPortSha256": { "$ref": "#/$defs/sha" },
    "postgresMigrationSha256": { "$ref": "#/$defs/sha" }, "postgresRaceCatalogSha256": { "$ref": "#/$defs/sha" }, "postgresRaceByteIndexSha256": { "$ref": "#/$defs/sha" },
    "codexPortSha256": { "$ref": "#/$defs/sha" }, "codexProfileSha256": { "$ref": "#/$defs/sha" }, "macosPhysicalContractSha256": { "$ref": "#/$defs/sha" }, "macosBuildRecipeSha256": { "$ref": "#/$defs/sha" },
    "constructedFileCount": { "type": "integer", "minimum": 1 }, "constructedFilesAggregateSha256": { "$ref": "#/$defs/sha" },
    "postgresNamedFamilies": { "const": 13 }, "postgresExecutableCases": { "const": 16 }, "postgresOrderedExecutions": { "const": 32 }, "postgresExpectedCoreCalls": { "const": 68 }, "postgresExpected2xx": { "const": 39 }, "postgresExpectedControlledNon2xx": { "const": 29 }, "postgresExpectedNewReceipts": { "const": 37 }, "postgresPersistedVerifierPlans": { "const": 32 },
    "offlineTestFiles": { "type": "integer", "minimum": 4 }, "offlineTestsPassed": { "type": "integer", "minimum": 1 }, "deterministicStressRuns": { "const": 3 }, "fakeChildStarts": { "type": "integer", "minimum": 0 }, "normalCompilerTestStarts": { "type": "integer", "minimum": 0 },
    "dockerReadOnlyCliCalls": { "enum": [0, 3] }, "localDockerUnixSocketRequests": { "enum": [0, 2] }, "macosReadOnlyInspectionCalls": { "enum": [0, 9] },
    "gitPushCommands": { "const": 0 }, "githubIssuesUpdated": { "const": 0 }, "publicationPushPlanned": { "const": 1 }, "githubIssueUpdatesPlanned": { "const": 2 },
    "dockerMutationCalls": { "const": 0 }, "postgresCalls": { "const": 0 }, "realCodexCalls": { "const": 0 }, "sandboxExecCalls": { "const": 0 }, "threadStarts": { "const": 0 }, "turnStarts": { "const": 0 }, "providerCalls": { "const": 0 }, "macosPhysicalCompileCalls": { "const": 0 }, "appAssemblyCalls": { "const": 0 }, "codesignCalls": { "const": 0 }, "securityCalls": { "const": 0 }, "localAuthenticationCalls": { "const": 0 }, "helperLaunches": { "const": 0 }, "candidateHandoffs": { "const": 0 },
    "hostBindingAttempted": { "type": "boolean" }, "hostBindingId": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$" }, "hostBindingCapsuleSha256": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] }, "hostBindingPublicReceiptSha256": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] }, "hostBindingExpiresAt": { "type": ["string", "null"], "format": "date-time" },
    "constructionRunRootAbsent": { "const": true }, "fakeProcessGroupsAbsent": { "const": true }, "bindingInputAbsent": { "const": true }, "constructionJournalAbsent": { "const": true }, "cleanupStatus": { "const": "GREEN" },
    "retryExecutionGrant": { "const": "NOT_REQUESTED" }, "firstProviderCallGrant": { "const": "NOT_REQUESTED" }, "aggregateVerdict": { "const": "YELLOW" }
