{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forme.local/schemas/r4/gate-b-core/host-binding-reattempt-input.schema.json",
  "title": "R4 Gate B Host Binding Reattempt Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dockerCli", "dockerUnixSocket", "codexPackageRoot"],
  "properties": {
    "schemaVersion": { "const": "r4_gate_b_host_binding_reattempt_input.v2" },
    "dockerCli": { "$ref": "#/$defs/absolutePath" },
    "dockerUnixSocket": { "$ref": "#/$defs/absolutePath" },
    "codexPackageRoot": { "$ref": "#/$defs/absolutePath" }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*~)(?!.*\\/$)/[^\\u0000\\r\\n]+$"
    }
  }
}
