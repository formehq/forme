ObjC.import("Foundation");

function mkdir(path) {
  const manager = $.NSFileManager.defaultManager;
  const error = Ref();
  const ok = manager.createDirectoryAtPathWithIntermediateDirectoriesAttributesError(
    $(path),
    true,
    $(),
    error,
  );
  if (!ok) throw new Error(`cannot create ${path}: ${ObjC.unwrap(error[0])}`);
}

function writeText(path, value) {
  const error = Ref();
  const ok = $(String(value)).writeToFileAtomicallyEncodingError(
    $(path),
    true,
    $.NSUTF8StringEncoding,
    error,
  );
  if (!ok) throw new Error(`cannot write ${path}: ${ObjC.unwrap(error[0])}`);
}

function safeSegment(value, fallback) {
  const cleaned = String(value || "")
    .normalize("NFC")
    .replace(/[\x00-\x1f/:]/g, "-")
    .replace(/^\.+$/, "-")
    .trim()
    .slice(0, 80);
  return cleaned || fallback;
}

function stableSuffix(id, fallback) {
  const parts = String(id || "").split("/");
  return safeSegment(parts[parts.length - 1], fallback).slice(-32);
}

function iso(value) {
  try {
    return value.toISOString();
  } catch (_) {
    return null;
  }
}

function folderParts(folder) {
  const parts = [];
  let current = folder;
  for (let depth = 0; current && depth < 20; depth += 1) {
    try {
      parts.unshift(safeSegment(current.name(), "Untitled Folder"));
    } catch (_) {
      break;
    }
    try {
      current = current.container();
      current.name();
    } catch (_) {
      break;
    }
  }
  return parts;
}

function attachmentName(attachment, index) {
  try {
    return safeSegment(attachment.name(), `attachment-${String(index + 1).padStart(3, "0")}`);
  } catch (_) {
    return `attachment-${String(index + 1).padStart(3, "0")}`;
  }
}

function run(argv) {
  if (argv.length !== 1) throw new Error("usage: export.jxa OUTPUT_DIRECTORY");

  const output = String(argv[0]).replace(/\/$/, "");
  const rawRoot = `${output}/raw`;
  const attachmentRoot = `${output}/attachments`;
  mkdir(rawRoot);
  mkdir(attachmentRoot);

  const Notes = Application("Notes");
  const startedAt = Date.now();
  const notes = Notes.notes();
  const enumeratedAt = Date.now();
  const records = [];
  let attachmentCount = 0;
  let attachmentSaved = 0;
  let attachmentFailed = 0;
  let bodyCharacters = 0;

  for (let index = 0; index < notes.length; index += 1) {
    const note = notes[index];
    const noteStartedAt = Date.now();
    const id = String(note.id());
    const suffix = stableSuffix(id, `note-${index + 1}`);
    const title = String(note.name() || "Untitled Note");
    const folder = folderParts(note.container());
    const locked = Boolean(note.passwordProtected());
    const noteAttachments = note.attachments();
    const attachments = [];
    let html = "";
    let readError = null;

    if (!locked) {
      try {
        html = String(note.body() || "");
        bodyCharacters += html.length;
      } catch (error) {
        readError = String(error);
      }
    }

    const noteRawDir = `${rawRoot}/${suffix}`;
    const noteAttachmentDir = `${attachmentRoot}/${suffix}`;
    mkdir(noteRawDir);
    if (noteAttachments.length > 0) mkdir(noteAttachmentDir);
    const htmlPath = `${noteRawDir}/note.html`;
    writeText(htmlPath, html);

    for (let attachmentIndex = 0; attachmentIndex < noteAttachments.length; attachmentIndex += 1) {
      attachmentCount += 1;
      const attachment = noteAttachments[attachmentIndex];
      const name = attachmentName(attachment, attachmentIndex);
      const path = `${noteAttachmentDir}/${name}`;
      let saveError = null;
      let saved = false;
      try {
        Notes.save(attachment, { in: Path(path) });
        saved = true;
        attachmentSaved += 1;
      } catch (error) {
        saveError = String(error);
        attachmentFailed += 1;
      }

      let contentIdentifier = null;
      let url = null;
      try { contentIdentifier = String(attachment.contentIdentifier() || "") || null; } catch (_) {}
      try { url = String(attachment.url() || "") || null; } catch (_) {}
      attachments.push({
        id: String(attachment.id()),
        name,
        contentIdentifier,
        url,
        saved,
        relativePath: saved ? `attachments/${suffix}/${name}` : null,
        error: saveError,
      });
    }

    records.push({
      id,
      title,
      folder,
      locked,
      shared: Boolean(note.shared()),
      createdAt: iso(note.creationDate()),
      modifiedAt: iso(note.modificationDate()),
      rawHtmlPath: `raw/${suffix}/note.html`,
      markdownPath: null,
      attachments,
      readError,
      readMs: Date.now() - noteStartedAt,
    });
  }

  const finishedAt = Date.now();
  const manifest = {
    format: "forme-apple-notes-spike-v1",
    generatedAt: new Date().toISOString(),
    aggregate: {
      notes: records.length,
      locked: records.filter((note) => note.locked).length,
      shared: records.filter((note) => note.shared).length,
      readErrors: records.filter((note) => note.readError).length,
      attachments: attachmentCount,
      attachmentsSaved: attachmentSaved,
      attachmentsFailed: attachmentFailed,
      bodyCharacters,
    },
    timings: {
      enumerateMs: enumeratedAt - startedAt,
      extractMs: finishedAt - enumeratedAt,
      totalMs: finishedAt - startedAt,
    },
    notes: records,
  };
  writeText(`${output}/manifest.json`, `${JSON.stringify(manifest, null, 2)}\n`);

  return JSON.stringify({
    output,
    aggregate: manifest.aggregate,
    timings: manifest.timings,
  });
}
